# MongoDB Atlas : chaîne de connexion (cluster gratuit M0), ex. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/job-hunter
MONGODB_URI=

# Compte Gmail expéditeur (idéalement un compte dédié au bot)
GMAIL_USER=
# Mot de passe d'application Gmail (16 caractères, validation en 2 étapes requise). PAS le mot de passe du compte.
GMAIL_APP_PASSWORD=
# Destinataire du digest (ton propre email)
EMAIL_TO=

# --- Bonus optionnel : notation IA des offres (désactivé par défaut) ---
ENABLE_AI_SCORING=false
ANTHROPIC_API_KEY=
